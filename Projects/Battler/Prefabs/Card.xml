            <RectangleComponent width="40" height="24" cornerRadius="0.3"/>
            <TransformComponent x="93" y="168"/>
        </Entity>
        <Entity id="7">
            <LayerComponent name="ui"/>
            <NameComponent name="RedCost"/>
            <ParentComponent target="0"/>
            <TextComponent text="-" fontSize="22" r="255" g="255" b="255" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="27" y="180"/>
        </Entity>
        <Entity id="8">
            <LayerComponent name="ui"/>
