<!-- The character mode of Scenes/CharacterSheet.xml (opened from the Town with I): the
     inventory grid on the left, the character with its equipment slots in the middle, and its
     attributes on the right. The scene fills the grid (ItemSlot.xml) and stands the model in
     the middle panel; the model is drawn on the scene's "model" layer, between "panel" and "ui". -->
<Prefab>
    <Entities>
        <Entity id="0">
            <LayerComponent name="ui"/>
            <NameComponent name="CharacterSheet"/>
            <TransformComponent x="86" y="110"/>
        </Entity>
        <Entity id="1">
            <LayerComponent name="panel"/>
            <MaterialComponent padding="0" enabled="true">
                <Layer material="Gradient" enabled="true">
                    <Uniform name="uColorA" type="vec4" value="0.020000 0.020000 0.040000 0.960000"/>
                    <Uniform name="uColorB" type="vec4" value="0.120000 0.080000 0.030000 0.900000"/>
                    <Uniform name="uAngle" type="float" value="90.000000"/>
                </Layer>
                <Layer material="Stroke" enabled="true">
                    <Uniform name="uWidth" type="float" value="2.000000"/>
                    <Uniform name="uColor" type="vec4" value="0.353000 0.353000 0.392000 1.000000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="InventoryPanel"/>
            <ParentComponent target="0"/>
            <RectangleComponent width="340" height="500" cornerRadius="0.04"/>
            <TransformComponent x="0" y="0"/>
        </Entity>
        <Entity id="2">
            <LayerComponent name="ui"/>
            <NameComponent name="InventoryTitle"/>
            <ParentComponent target="1"/>
            <TextComponent text="Inventory" fontSize="30" r="255" g="210" b="110" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="170" y="26"/>
        </Entity>
