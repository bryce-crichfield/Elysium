                    <Uniform name="uColor" type="vec4" value="0.353000 0.353000 0.392000 1.000000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="ModelPanel"/>
            <ParentComponent target="0"/>
            <RectangleComponent width="400" height="500" cornerRadius="0.04"/>
            <TransformComponent x="354" y="0"/>
