<!-- The hovered or selected unit's stats, bottom left of the battle: Name (in its team's
     color), Hp, Stats and its Spell, if it has one. BattleScene.lua fills it in and hides it
     when there's no unit to show. -->
<Prefab>
    <Entities>
        <Entity id="0">
            <LayerComponent name="ui"/>
            <MaterialComponent padding="0" enabled="true">
                <Layer material="Flat" enabled="true">
                    <Uniform name="uColor" type="vec4" value="0.055000 0.055000 0.086000 0.824000"/>
                </Layer>
                <Layer material="Stroke" enabled="true">
                    <Uniform name="uWidth" type="float" value="1.500000"/>
                    <Uniform name="uColor" type="vec4" value="0.353000 0.353000 0.392000 1.000000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="UnitCard"/>
            <RectangleComponent width="300" height="104" cornerRadius="0.08"/>
            <TransformComponent x="16" y="600"/>
        </Entity>
        <Entity id="1">
            <LayerComponent name="ui"/>
            <NameComponent name="Name"/>
            <ParentComponent target="0"/>
            <TextComponent text="Unit" fontSize="26" r="120" g="190" b="255" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="60" y="22"/>
        </Entity>
        <Entity id="2">
            <LayerComponent name="ui"/>
            <NameComponent name="Hp"/>
            <ParentComponent target="0"/>
            <TextComponent text="HP 0 / 0" fontSize="22" r="235" g="235" b="240" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="60" y="50"/>
        </Entity>
        <Entity id="3">
            <LayerComponent name="ui"/>
            <NameComponent name="Stats"/>
            <ParentComponent target="0"/>
            <TextComponent text="ATK 0  DEF 0  MOV 0" fontSize="20" r="160" g="160" b="175" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="90" y="73"/>
        </Entity>
        <Entity id="4">
            <LayerComponent name="ui"/>
            <NameComponent name="Spell"/>
            <ParentComponent target="0"/>
            <TextComponent text="" fontSize="18" r="160" g="160" b="175" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="110" y="94"/>
        </Entity>
    </Entities>
</Prefab>
