<!-- A card's row in the deck builder's list (Scenes/CharacterSheet.xml, deck mode): a
     thumbnail of its art, its title and its cost. Hovering it pops up the whole card. -->
<Prefab>
    <Entities>
        <Entity id="0">
            <LayerComponent name="ui"/>
            <MaterialComponent padding="0" enabled="true">
                <Layer material="Flat" enabled="true">
                    <Uniform name="uColor" type="vec4" value="0.050000 0.050000 0.080000 0.850000"/>
                </Layer>
                <Layer material="Stroke" enabled="true">
                    <Uniform name="uWidth" type="float" value="1.500000"/>
                    <Uniform name="uColor" type="vec4" value="0.300000 0.300000 0.340000 1.000000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="DeckRow"/>
            <RectangleComponent width="332" height="44" cornerRadius="0.2"/>
            <TransformComponent x="0" y="0"/>
        </Entity>
        <Entity id="1">
            <LayerComponent name="ui"/>
            <MaterialComponent padding="0" enabled="true">
                <Layer material="Texture" enabled="true"/>
            </MaterialComponent>
            <NameComponent name="Art"/>
            <ParentComponent target="0"/>
            <RectangleComponent width="56" height="36" cornerRadius="0.15000001"/>
            <TransformComponent x="4" y="4"/>
        </Entity>
        <Entity id="2">
            <LayerComponent name="ui"/>
            <NameComponent name="Title"/>
            <ParentComponent target="0"/>
            <TextComponent text="Card" fontSize="22" r="255" g="225" b="160" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="120" y="22"/>
        </Entity>
        <Entity id="3">
            <LayerComponent name="ui"/>
            <NameComponent name="Cost"/>
            <ParentComponent target="0"/>
            <TextComponent text="0" fontSize="22" r="140" g="180" b="255" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="312" y="22"/>
        </Entity>
    </Entities>
</Prefab>
