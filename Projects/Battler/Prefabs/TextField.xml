<!-- A one-line text field for Screen2D menus (Scripts/Components/TextField.lua). The scene binds
     its text by the placement id: Widgets.Bind(id, get, set), with strings. Click it to focus;
     Enter, Esc or a click elsewhere drops focus. Label sits above the box, Text inside it. -->
<Prefab>
    <Parameters>
        <Parameter name="Label" entity="1" component="TextComponent" field="text"/>
        <Parameter name="Width" entity="0" component="RectangleComponent" field="width"/>
    </Parameters>
    <Entities>
        <Entity id="0">
            <LayerComponent name="ui"/>
            <MaterialComponent padding="30" enabled="true">
                <Layer material="Fire" enabled="true">
                    <Uniform name="uIntensity" type="float" value="0.000000"/>
                    <Uniform name="uGlowColor" type="vec3" value="1.000000 0.560000 0.100000"/>
                    <Uniform name="uGlowRadius" type="float" value="8.000000"/>
                    <Uniform name="uInteriorFade" type="float" value="0.000000"/>
                </Layer>
                <Layer material="Gradient" enabled="true">
                    <Uniform name="uColorA" type="vec4" value="0.000000 0.000000 0.000000 0.920000"/>
                    <Uniform name="uColorB" type="vec4" value="0.120000 0.080000 0.030000 0.250000"/>
                    <Uniform name="uAngle" type="float" value="0.000000"/>
                </Layer>
                <Layer material="Stroke" enabled="true">
                    <Uniform name="uWidth" type="float" value="2.000000"/>
                    <Uniform name="uColor" type="vec4" value="0.353000 0.353000 0.392000 1.000000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="TextField"/>
            <RectangleComponent width="440" height="40" cornerRadius="0.2"/>
            <ScriptComponent>
                <Script name="Scripts/Components/TextField.lua"/>
            </ScriptComponent>
            <TransformComponent x="0" y="0"/>
        </Entity>
        <Entity id="1">
            <LayerComponent name="ui"/>
            <NameComponent name="Label"/>
            <ParentComponent target="0"/>
            <TextComponent text="Label" fontSize="24" r="160" g="160" b="175" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="40" y="-16"/>
        </Entity>
        <Entity id="2">
            <LayerComponent name="ui"/>
            <NameComponent name="Text"/>
            <ParentComponent target="0"/>
            <TextComponent text="" fontSize="26" r="235" g="235" b="240" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="12" y="20"/>
        </Entity>
    </Entities>
</Prefab>
