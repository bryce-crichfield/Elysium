                    <Uniform name="uColorB" type="vec4" value="0.150000 0.650000 0.950000 1.000000"/>
                    <Uniform name="uRimColor" type="vec4" value="0.750000 0.600000 1.000000 1.000000"/>
                    <Uniform name="uScale" type="float" value="0.025000"/>
                    <Uniform name="uSpeed" type="float" value="0.300000"/>
                </Layer>
            </MaterialComponent>
            <NameComponent name="Disc"/>
            <ParentComponent target="0"/>
            <TransformComponent x="0" y="0" z="56"/>
        </Entity>
    </Entities>
</Prefab>
