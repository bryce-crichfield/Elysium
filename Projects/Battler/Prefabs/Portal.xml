    <Entities>
        <Entity id="0">
            <LayerComponent name="entity"/>
            <LightComponent color="#9A6CFFFF" intensity="2" radius="380" height="60" flicker="0.15" vision="false"/>
            <NameComponent name="Portal"/>
            <TransformComponent x="0" y="0"/>
        </Entity>
        <Entity id="1">
            <CircleComponent radius="48"/>
            <LayerComponent name="entity"/>
            <MaterialComponent padding="0" enabled="true">
                <Layer material="Nebula" enabled="true">
                    <Uniform name="uDeep" type="vec4" value="0.030000 0.010000 0.080000 1.000000"/>
