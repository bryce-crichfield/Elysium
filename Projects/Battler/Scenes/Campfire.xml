<Scene>
    <SceneScript path="Scripts/CampfireScene.lua"/>
    <EditorMetadata gridDivisor="1" gridHeight="32" gridLattice="Isometric" gridShow="false" gridSnap="false" gridWidth="64"/>
    <Systems>
        <System type="ScriptSystem"/>
        <System type="TransformSystem"/>
        <System type="RenderSystem"/>
    </Systems>
    <SceneConfiguration width="1920" height="1080">
        <SceneLayer name="background" z="0" space="Screen2D" layerBlend="Normal" compositeBlend="Normal" isComposited="false" isVisible="true" opacity="1"/>
        <SceneLayer name="ui" z="10" space="Screen2D" layerBlend="Normal" compositeBlend="Normal" isComposited="false" isVisible="true" opacity="1"/>
    </SceneConfiguration>
    <Entities>
        <Entity name="CAMERA">
            <NameComponent name="CAMERA"/>
            <TransformComponent x="0" y="0"/>
            <CameraComponent/>
        </Entity>
        <Entity name="Title">
            <LayerComponent name="ui"/>
            <NameComponent name="Title"/>
            <TextComponent text="The Campfire" fontSize="72" r="255" g="170" b="90" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="640" y="140"/>
        </Entity>
        <Entity name="Status">
            <LayerComponent name="ui"/>
            <NameComponent name="Status"/>
            <TextComponent text="" fontSize="30" r="220" g="220" b="230" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="640" y="240"/>
        </Entity>
        <Entity name="Note">
            <LayerComponent name="ui"/>
            <NameComponent name="Note"/>
            <TextComponent text="Level up, trade and manage the party here (soon)" fontSize="20" r="140" g="140" b="155" a="255" font="Fonts/EnchantedLand-Regular.ttf"/>
            <TransformComponent x="640" y="290"/>
        </Entity>
    </Entities>
    <PrefabInstance src="../Prefabs/MenuBackground.xml" id="Background"/>
    <PrefabInstance src="../Prefabs/Button.xml" id="Descend">
        <Param name="Label" value="Descend"/>
        <Override entity="0" component="TransformComponent" field="x" value="480"/>
        <Override entity="0" component="TransformComponent" field="y" value="420"/>
    </PrefabInstance>
    <PrefabInstance src="../Prefabs/Button.xml" id="Abandon">
        <Param name="Label" value="Main Menu"/>
        <Override entity="0" component="TransformComponent" field="x" value="480"/>
        <Override entity="0" component="TransformComponent" field="y" value="492"/>
    </PrefabInstance>
</Scene>
